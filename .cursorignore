# =========================================================================
# .cursorignore
# Cursor の AI から見せないファイル。書式は .gitignore と同じ。
#
# docs/ui_reference/ の HTML / CSS / JS はデザインの正本なので読ませる。
# 画像・動画・PDF だけ除外する。
# =========================================================================

# ---- 依存 ----
node_modules/
vendor/

# ---- ビルド成果物 ----
dist/
build/
.cache/
.parcel-cache/

# ---- ロックファイル ----
pnpm-lock.yaml
package-lock.json
yarn.lock
composer.lock

# ---- OS / IDE ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~

# ---- ログ・一時ファイル ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
tmp/

# ---- 環境変数 / シークレット ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- 画像・動画・バイナリ ----
images/
docs/ui_reference/**/images/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg
*.ico
*.mp4
*.webm
*.mov
*.zip
*.tar
*.tar.gz
*.tgz
*.pdf

# ---- Vite / TypeScript 中間生成物 ----
*.tsbuildinfo
.vite/

# ---- 翻訳ファイル（バイナリ） ----
languages/*.mo

# ---- WordPress 本体・他テーマ・プラグイン ----
wp-admin/
wp-includes/
wp-content/plugins/
wp-content/uploads/
wp-content/mu-plugins/
