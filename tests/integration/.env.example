# Copy this file to tests/integration/.env and adjust the values for your Local site.
#
# Local by Flywheel:
# - Open the site in Local
# - Database tab
# - Use the Host and Port shown there
#
# The integration test suite resets WP_TESTS_DB_NAME on each run.
# Never point this to your development database.
#
# This theme is already under:
#   wp-content/themes/wp_theme-bakery_modan
WP_TESTS_DB_NAME=local_tests
WP_TESTS_DB_USER=root
WP_TESTS_DB_PASSWORD=root
WP_TESTS_DB_HOST=127.0.0.1:10000
